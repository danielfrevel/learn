{
  "hooks": {
    "UserPromptSubmit": [
      { "hooks": [{ "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/src/mdlog/cli.ts\" sync", "timeout": 10 }] }
    ],
    "PreToolUse": [
      { "matcher": "mcp__plugin_learn_quiz__quiz|mcp__plugin_learn_quiz__show|AskUserQuestion", "hooks": [{ "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/src/mdlog/cli.ts\" sync", "timeout": 10 }] }
    ],
    "PostToolUse": [
      { "matcher": "mcp__plugin_learn_quiz__quiz|mcp__plugin_learn_quiz__show|AskUserQuestion", "hooks": [{ "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/src/mdlog/cli.ts\" sync", "timeout": 10 }] }
    ],
    "Stop": [
      { "hooks": [{ "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/src/mdlog/cli.ts\" sync", "timeout": 10 }] }
    ]
  }
}
